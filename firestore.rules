rules_version = '2';

// Kosodate Hub Firestore Security Rules
// 方針: deny by default。家族データは members/{uid}.status == 'active' のみ読取可。
// クライアントは「create のみ」（イベント・予定等）。更新・削除は Callable Functions（Admin SDK）経由。
//
// get()/exists() の呼び出し回数上限について:
//   単一ドキュメント操作では 1 リクエストあたり 10 回まで。同一パスは 1 回として数える。
//   最大: 作成者の members(1) + 子ども exists(1) + 担当/宛先 uid(最大 2) + 他(1) = 5 程度。
//   リスト要素はルールにループが無いため、件数上限を UI 実使用に合わせて縮め、固定インデックスで検証する。
//   (家族は最大 2 人 → assigneeUids/recipientUids は size<=2。relatedRefs は UI 上限 5)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // 共通ヘルパー
    // ---------------------------------------------------------------
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/system/accountDeletion/users/$(request.auth.uid));
    }

    function memberPath(familyId, uid) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(uid);
    }

    function isActiveMember(familyId) {
      return signedIn()
        && get(/databases/$(database)/documents/families/$(familyId)).data.status == 'active'
        && exists(memberPath(familyId, request.auth.uid))
        && get(memberPath(familyId, request.auth.uid)).data.status == 'active';
    }

    function isActiveMemberUid(familyId, uid) {
      return uid is string
        && exists(memberPath(familyId, uid))
        && get(memberPath(familyId, uid)).data.status == 'active';
    }

    // ---- 型・長さ ----
    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    function isStrNE(v, maxLen) {
      return v is string && v.size() >= 1 && v.size() <= maxLen;
    }
    function optStr(d, k, maxLen) {
      return !(k in d) || isStr(d[k], maxLen);
    }
    function optStrNull(d, k, maxLen) {
      return !(k in d) || d[k] == null || isStr(d[k], maxLen);
    }
    // 数値: NaN は比較が false になるため範囲指定で排除される。Infinity も上限で排除。
    function isNumRange(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }
    function optNum(d, k, lo, hi) {
      return !(k in d) || isNumRange(d[k], lo, hi);
    }
    function optNumNull(d, k, lo, hi) {
      return !(k in d) || d[k] == null || isNumRange(d[k], lo, hi);
    }
    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }
    function isHttpsUrl(v) {
      return v is string && v.size() <= 2000 && v.matches('^https://[^\\s]+$');
    }
    function optUrl(d, k) {
      return !(k in d) || d[k] == null || isHttpsUrl(d[k]);
    }
    function isDateStr(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function optDateNull(d, k) {
      return !(k in d) || d[k] == null || isDateStr(d[k]);
    }
    function optEnum(d, k, allowed) {
      return !(k in d) || d[k] in allowed;
    }
    // ---- ID / 時刻 / リスト ----
    function idOk(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    // 未来は 10 分まで許容（端末時計のずれ）。過去は自由（オフライン後の同期）。
    function notFuture(t) {
      return t is timestamp && t <= request.time + duration.value(10, 'm');
    }
    // 自由入力のタグ配列: 最大 10 件・各 30 文字以内の string（固定インデックスで検証）
    function tagItemOk(l, i) {
      return l.size() <= i || (l[i] is string && l[i].size() <= 30);
    }
    function tagListOk(l) {
      return l is list && l.size() <= 10
        && tagItemOk(l, 0) && tagItemOk(l, 1) && tagItemOk(l, 2) && tagItemOk(l, 3) && tagItemOk(l, 4)
        && tagItemOk(l, 5) && tagItemOk(l, 6) && tagItemOk(l, 7) && tagItemOk(l, 8) && tagItemOk(l, 9);
    }
    function optTagList(d, k) {
      return !(k in d) || tagListOk(d[k]);
    }
    // 固定候補のタグ配列
    function fixedTagsOk(l, allowed) {
      return l is list && l.size() <= allowed.size() && l.hasOnly(allowed);
    }
    // 関連参照
    function refOk(l, i) {
      return l.size() <= i || (
        l[i] is map
        && l[i].keys().hasOnly(['kind', 'id', 'childId'])
        && l[i].keys().hasAll(['kind', 'id'])
        && l[i].kind in ['event', 'schedule', 'task', 'shopping', 'handover', 'medicalVisit', 'vaccination', 'medication']
        && idOk(l[i].id)
        && (!('childId' in l[i]) || idOk(l[i].childId)));
    }
    function refsOk(l) {
      return l is list && l.size() <= 5
        && refOk(l, 0) && refOk(l, 1) && refOk(l, 2) && refOk(l, 3) && refOk(l, 4);
    }
    // 担当/宛先 uid 配列: 最大 2 件（家族は最大 2 人）、各要素は有効メンバー
    function uidsOk(familyId, l) {
      return l is list && l.size() <= 2
        && (l.size() < 1 || isActiveMemberUid(familyId, l[0]))
        && (l.size() < 2 || (isActiveMemberUid(familyId, l[1]) && l[0] != l[1]));
    }
    // 文字列配列: 件数のみ検証（要素の型・長さはルールでは検証不可 → Functions/Web側）
    function isListMax(v, maxLen) {
      return v is list && v.size() <= maxLen;
    }
    function optListMax(d, k, maxLen) {
      return !(k in d) || isListMax(d[k], maxLen);
    }

    // ---- 共通メタデータ（クライアント create）----
    function commonCreateOk(d) {
      return d.createdBy == request.auth.uid
        && d.updatedBy == request.auth.uid
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.revision == 1;
    }
    function commonKeys() {
      return ['createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision'];
    }

    // ---------------------------------------------------------------
    // users
    // ---------------------------------------------------------------
    function settingsOk(s) {
      return s is map
        && s.keys().hasOnly(['theme', 'quietHours', 'notify', 'homeItems', 'quickRecordTypes'])
        && optEnum(s, 'theme', ['system', 'light', 'dark'])
        && (!('quietHours' in s) || (
              s.quietHours is map
              && s.quietHours.keys().hasOnly(['enabled', 'start', 'end'])
              && optBool(s.quietHours, 'enabled')
              && (!('start' in s.quietHours) || (s.quietHours.start is string && s.quietHours.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
              && (!('end' in s.quietHours) || (s.quietHours.end is string && s.quietHours.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))))
        && (!('notify' in s) || (
              s.notify is map
              && s.notify.keys().hasOnly(['handoverImportant', 'handoverNormal', 'scheduleReminder', 'taskDue', 'dose'])
              && optBool(s.notify, 'handoverImportant')
              && optBool(s.notify, 'handoverNormal')
              && optBool(s.notify, 'scheduleReminder')
              && optBool(s.notify, 'taskDue')
              && optBool(s.notify, 'dose')))
        && optListMax(s, 'homeItems', 7)
        && optListMax(s, 'quickRecordTypes', 6);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && idOk(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'settings'])
        && (!('displayName' in request.resource.data) || isStr(request.resource.data.displayName, 50))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && (!('settings' in request.resource.data) || settingsOk(request.resource.data.settings));
      // 更新は displayName / settings のみ（createdAt 等は変更不可）
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'settings'])
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'settings'])
        && (!('displayName' in request.resource.data) || isStr(request.resource.data.displayName, 50))
        && (!('settings' in request.resource.data) || settingsOk(request.resource.data.settings));
      allow delete: if false; // アカウント削除は deleteAccount Function

      // 所属索引: サーバーのみ書込み、本人読取
      match /familyRefs/{familyId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if false; // 登録・設定変更は上限を検証するサーバー経由
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------------------------------------------------------------
    // イベント検証
    // ---------------------------------------------------------------
    function yesNoUnknown(v) {
      return v in ['yes', 'no', 'unknown'];
    }

    function feedingOk(p) {
      return p.keys().hasOnly(['method', 'consumedMl', 'leftSeconds', 'rightSeconds', 'feedingSessionId'])
        && p.keys().hasAll(['method'])
        && p.method in ['breast', 'formula', 'expressed_breast_milk']
        && optNum(p, 'consumedMl', 0, 500)
        && optNum(p, 'leftSeconds', 0, 7200)
        && optNum(p, 'rightSeconds', 0, 7200)
        && (!('feedingSessionId' in p) || isStrNE(p.feedingSessionId, 200));
    }
    function pumpingOk(p) {
      return p.keys().hasOnly(['expressedMl']) && optNum(p, 'expressedMl', 0, 500);
    }
    function diaperOk(p) {
      return p.keys().hasOnly(['urine', 'stool', 'changed', 'stoolNote'])
        && p.keys().hasAll(['urine', 'stool', 'changed'])
        && yesNoUnknown(p.urine) && yesNoUnknown(p.stool)
        && p.changed is bool
        && optStr(p, 'stoolNote', 200);
    }
    function sleepStartOk(p) {
      return p.keys().hasOnly(['sessionId']) && isStrNE(p.get('sessionId', null), 200);
    }
    function sleepEndOk(p) {
      return p.keys().hasOnly(['sessionId', 'startEventId'])
        && isStrNE(p.get('sessionId', null), 200)
        && isStrNE(p.get('startEventId', null), 200);
    }
    function bathOk(p) {
      return p.keys().hasOnly(['bathingMode']) && optEnum(p, 'bathingMode', ['sponge', 'tub']);
    }
    function vomitOk(p) {
      return p.keys().hasOnly(['amountCategory', 'appearanceText', 'contextTags'])
        && optEnum(p, 'amountCategory', ['small', 'medium', 'large', 'unknown'])
        && optStr(p, 'appearanceText', 200)
        && optTagList(p, 'contextTags');
    }
    function temperatureOk(p) {
      return p.keys().hasOnly(['celsius', 'measurementMethod'])
        && p.keys().hasAll(['celsius'])
        && isNumRange(p.celsius, 30, 45)
        && optEnum(p, 'measurementMethod', ['axillary', 'ear', 'forehead', 'rectal', 'other']);
    }
    function symptomOk(p) {
      return p.keys().hasOnly(['symptomTags', 'observedText'])
        && p.keys().hasAll(['symptomTags'])
        && fixedTagsOk(p.symptomTags, ['咳', '鼻水', '機嫌が悪い', '食欲が落ちた', '発疹', '下痢', 'ぐったりして見える', 'よく泣く', 'その他'])
        && optStr(p, 'observedText', 2000);
    }
    function growthOk(p) {
      return p.keys().hasOnly(['heightCm', 'weightGrams', 'measurementPlace'])
        && (('heightCm' in p) || ('weightGrams' in p))
        && optNum(p, 'heightCm', 20, 150)
        && optNum(p, 'weightGrams', 300, 50000)
        && optStr(p, 'measurementPlace', 200);
    }
    function freeTextOk(p) {
      return p.keys().hasOnly(['text', 'tags'])
        && optStr(p, 'text', 2000)
        && (!('tags' in p) || fixedTagsOk(p.tags, ['機嫌がよい', 'ぐずり', 'よく泣く', 'よく笑った', 'しゃっくり', '湿疹', '肌が赤い', 'うんちの色が気になる', 'いつもと違う', 'できたこと']));
    }

    // type ごとの payload 検証。medication_taken は含めない（サーバーのみ作成）。
    function payloadOk(type, p) {
      return p is map && (
           (type == 'feeding' && feedingOk(p))
        || (type == 'pumping' && pumpingOk(p))
        || (type == 'diaper' && diaperOk(p))
        || (type == 'sleep_start' && sleepStartOk(p))
        || (type == 'sleep_end' && sleepEndOk(p))
        || (type == 'bath' && bathOk(p))
        || (type == 'vomit' && vomitOk(p))
        || (type == 'temperature' && temperatureOk(p))
        || (type == 'symptom' && symptomOk(p))
        || (type == 'growth' && growthOk(p))
        || ((type == 'meal' || type == 'milestone' || type == 'memo') && freeTextOk(p))
      );
    }

    function childExists(familyId, childId) {
      return exists(/databases/$(database)/documents/families/$(familyId)/children/$(childId));
    }

    function allergyOk(l, i) {
      return l.size() <= i || (
        l[i] is map
        && l[i].keys().hasOnly(['name', 'confirmation', 'source', 'note'])
        && l[i].keys().hasAll(['name', 'confirmation'])
        && isStrNE(l[i].name, 100)
        && l[i].confirmation in ['confirmed_by_doctor', 'suspected', 'unconfirmed']
        && optStr(l[i], 'source', 200)
        && optStr(l[i], 'note', 200));
    }
    // 式評価上限(1000)のため 10 件は不可（実測）。UI 実使用に合わせ 5 件まで。
    function allergiesOk(l) {
      return l is list && l.size() <= 5
        && allergyOk(l, 0) && allergyOk(l, 1) && allergyOk(l, 2) && allergyOk(l, 3) && allergyOk(l, 4);
    }

    function eventShapeOk(familyId, childId, d) {
      return d.keys().hasOnly([
            'schemaVersion', 'childId', 'type', 'occurredAt', 'endedAt', 'recordedAt',
            'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'caregiverUid',
            'sessionId', 'sourceRef', 'payload', 'note', 'revision', 'status'])
        && d.keys().hasAll([
            'schemaVersion', 'childId', 'type', 'occurredAt', 'recordedAt',
            'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'payload', 'revision', 'status'])
        && d.schemaVersion == 1
        && d.childId == childId
        && d.status == 'active'
        && commonCreateOk(d)
        && d.type is string
        && notFuture(d.occurredAt)
        && notFuture(d.recordedAt)
        && (!('endedAt' in d) || (notFuture(d.endedAt) && d.endedAt >= d.occurredAt))
        && optStr(d, 'sessionId', 200)
        && optStr(d, 'note', 2000)
        // contextEventIds はクライアント作成時は禁止（hasOnly から除外。関連付けは updateEvent Function）
        && (!('sourceRef' in d) || (
              d.sourceRef is map
              && d.sourceRef.keys().hasOnly(['kind', 'id'])
              && d.sourceRef.keys().hasAll(['kind', 'id'])
              && d.sourceRef.kind in ['doseOccurrence', 'event', 'schedule', 'task', 'handover', 'medicalVisit', 'vaccination', 'medication']
              && idOk(d.sourceRef.id)))
        && payloadOk(d.type, d.payload)
        // 睡眠: トップレベル sessionId は payload.sessionId と同値
        && (!(d.type in ['sleep_start', 'sleep_end']) || !('sessionId' in d) || d.sessionId == d.payload.sessionId)
        // 子どもの存在確認（get/exists 2 回目）
        && childExists(familyId, childId)
        // 実施者: null/未設定 または有効メンバー（get/exists 3 回目）
        && (!('caregiverUid' in d) || d.caregiverUid == null || isActiveMemberUid(familyId, d.caregiverUid));
    }

    // ---------------------------------------------------------------
    // families
    // ---------------------------------------------------------------
    match /families/{familyId} {
      allow read: if isActiveMember(familyId);
      allow write: if false; // createFamily / deleteFamily Function

      match /members/{uid} {
        // 自分自身の所属状態、または有効メンバーは読取可。書込みはサーバーのみ。
        allow read: if signedIn() && (request.auth.uid == uid || isActiveMember(familyId));
        allow write: if false;
      }

      match /auditLogs/{auditId} {
        allow read: if isActiveMember(familyId);
        allow write: if false;
      }

      match /children/{childId} {
        allow read: if isActiveMember(familyId);
        allow write: if false; // 作成は createFamily、更新は updateDoc Function

        // ---- events: クライアントは create のみ ----
        match /events/{eventId} {
          allow read: if isActiveMember(familyId);
          allow create: if isActiveMember(familyId)
            && idOk(eventId)
            && eventShapeOk(familyId, childId, request.resource.data);
          allow update, delete: if false;
        }

        match /healthProfiles/{docId} {
          allow read: if isActiveMember(familyId);
          allow create: if isActiveMember(familyId)
            && childExists(familyId, childId)
            && idOk(docId)
            && docId == 'main'
            && request.resource.data.keys().hasOnly(['allergies', 'conditionsNote', 'primaryClinic'].concat(commonKeys()))
            && request.resource.data.keys().hasAll(['allergies'].concat(commonKeys()))
            && commonCreateOk(request.resource.data)
            && allergiesOk(request.resource.data.allergies)
            && optStr(request.resource.data, 'conditionsNote', 2000)
            && (!('primaryClinic' in request.resource.data) || (
                  request.resource.data.primaryClinic is map
                  && request.resource.data.primaryClinic.keys().hasOnly(['name', 'phone', 'url'])
                  && request.resource.data.primaryClinic.keys().hasAll(['name'])
                  && isStrNE(request.resource.data.primaryClinic.name, 200)
                  && optStr(request.resource.data.primaryClinic, 'phone', 50)
                  && optUrl(request.resource.data.primaryClinic, 'url')));
          allow update, delete: if false;
        }

        match /medications/{medicationId} {
          allow read: if isActiveMember(familyId);
          allow create: if isActiveMember(familyId)
            && childExists(familyId, childId)
            && idOk(medicationId)
            && request.resource.data.keys().hasOnly(['name', 'instructionText', 'amount', 'unit', 'instructionSource',
                 'startDate', 'endDate', 'asNeeded', 'status'].concat(commonKeys()))
            && request.resource.data.keys().hasAll(['name', 'instructionText', 'instructionSource', 'asNeeded', 'status'].concat(commonKeys()))
            && commonCreateOk(request.resource.data)
            && isStrNE(request.resource.data.name, 200)
            && isStr(request.resource.data.instructionText, 2000)
            && isStr(request.resource.data.instructionSource, 200)
            && optNum(request.resource.data, 'amount', 0, 100000)
            && optStr(request.resource.data, 'unit', 20)
            && optDateNull(request.resource.data, 'startDate')
            && optDateNull(request.resource.data, 'endDate')
            && request.resource.data.asNeeded is bool
            && request.resource.data.status == 'active';
          allow update, delete: if false;
        }

        // 服薬予定・実績: サーバーのみ書込み（claim/complete は Function）
        match /doseOccurrences/{occurrenceId} {
          allow read: if isActiveMember(familyId);
          allow write: if false;
        }

        match /medicalVisits/{visitId} {
          allow read: if isActiveMember(familyId);
          allow create: if isActiveMember(familyId)
            && childExists(familyId, childId)
            && idOk(visitId)
            && request.resource.data.keys().hasOnly(['occurredOn', 'provider', 'reason', 'observations', 'questions',
                 'clinicianInstructions', 'nextAction', 'scheduleId'].concat(commonKeys()))
            && request.resource.data.keys().hasAll(['occurredOn', 'provider', 'reason'].concat(commonKeys()))
            && commonCreateOk(request.resource.data)
            && isDateStr(request.resource.data.occurredOn)
            && isStrNE(request.resource.data.provider, 200)
            && isStr(request.resource.data.reason, 2000)
            && optStr(request.resource.data, 'observations', 2000)
            && optStr(request.resource.data, 'questions', 2000)
            && optStr(request.resource.data, 'clinicianInstructions', 2000)
            && optStr(request.resource.data, 'nextAction', 2000)
            && (!('scheduleId' in request.resource.data) || request.resource.data.scheduleId == null || idOk(request.resource.data.scheduleId));
          allow update, delete: if false;
        }

        match /vaccinations/{vaccinationId} {
          allow read: if isActiveMember(familyId);
          allow create: if isActiveMember(familyId)
            && childExists(familyId, childId)
            && idOk(vaccinationId)
            && request.resource.data.keys().hasOnly(['name', 'doseLabel', 'status', 'scheduledDate', 'administeredDate',
                 'provider', 'scheduleId', 'source', 'kind'].concat(commonKeys()))
            && request.resource.data.keys().hasAll(['name', 'doseLabel', 'status', 'kind'].concat(commonKeys()))
            && commonCreateOk(request.resource.data)
            && isStrNE(request.resource.data.name, 200)
            && isStr(request.resource.data.doseLabel, 100)
            && request.resource.data.status in ['planned', 'reserved', 'administered', 'cancelled']
            && request.resource.data.kind in ['vaccination', 'checkup']
            && optDateNull(request.resource.data, 'scheduledDate')
            && optDateNull(request.resource.data, 'administeredDate')
            && optStr(request.resource.data, 'provider', 200)
            && (!('scheduleId' in request.resource.data) || request.resource.data.scheduleId == null || idOk(request.resource.data.scheduleId))
            && optStr(request.resource.data, 'source', 200);
          allow update, delete: if false;
        }
      }

      match /schedules/{scheduleId} {
        allow read: if isActiveMember(familyId);
        allow create: if isActiveMember(familyId)
          && idOk(scheduleId)
          && request.resource.data.keys().hasOnly(['title', 'category', 'childId', 'allDay', 'date', 'startAt', 'endAt',
               'location', 'timezone', 'assigneeUids', 'status', 'relatedRefs', 'preparation'].concat(commonKeys()))
          && request.resource.data.keys().hasAll(['title', 'category', 'allDay', 'timezone', 'assigneeUids', 'status', 'relatedRefs'].concat(commonKeys()))
          && commonCreateOk(request.resource.data)
          && isStrNE(request.resource.data.title, 200)
          && request.resource.data.category in ['medical', 'procedure', 'other']
          && (!('childId' in request.resource.data) || request.resource.data.childId == null || idOk(request.resource.data.childId))
          && request.resource.data.allDay is bool
          && (request.resource.data.allDay
                ? isDateStr(request.resource.data.get('date', null))
                : request.resource.data.get('startAt', null) is timestamp)
          && (!('date' in request.resource.data) || isDateStr(request.resource.data.date))
          && (!('startAt' in request.resource.data) || request.resource.data.startAt is timestamp)
          && (!('endAt' in request.resource.data) || request.resource.data.endAt is timestamp)
          && optStr(request.resource.data, 'location', 200)
          && isStrNE(request.resource.data.timezone, 64)
          && uidsOk(familyId, request.resource.data.assigneeUids)
          && request.resource.data.status == 'planned'
          && refsOk(request.resource.data.relatedRefs)
          && optStr(request.resource.data, 'preparation', 2000);
        allow update, delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isActiveMember(familyId);
        allow create: if isActiveMember(familyId)
          && idOk(taskId)
          && request.resource.data.keys().hasOnly(['title', 'category', 'assigneeUid', 'status', 'dueDate', 'deadlineBasis',
               'deadlineVerified', 'sourceUrl', 'sourceCheckedAt', 'step', 'relatedRefs'].concat(commonKeys()))
          && request.resource.data.keys().hasAll(['title', 'category', 'status', 'deadlineVerified', 'relatedRefs'].concat(commonKeys()))
          && commonCreateOk(request.resource.data)
          && isStrNE(request.resource.data.title, 200)
          && request.resource.data.category in ['procedure', 'household', 'medical', 'other']
          && request.resource.data.status == 'todo'
          && request.resource.data.deadlineVerified is bool
          && optDateNull(request.resource.data, 'dueDate')
          && optStr(request.resource.data, 'deadlineBasis', 200)
          && optUrl(request.resource.data, 'sourceUrl')
          && optDateNull(request.resource.data, 'sourceCheckedAt')
          && optStr(request.resource.data, 'step', 2000)
          && refsOk(request.resource.data.relatedRefs)
          && (!('assigneeUid' in request.resource.data) || request.resource.data.assigneeUid == null
              || isActiveMemberUid(familyId, request.resource.data.assigneeUid));
        allow update, delete: if false;
      }

      match /shopping/{itemId} {
        allow read: if isActiveMember(familyId);
        allow create: if isActiveMember(familyId)
          && idOk(itemId)
          && request.resource.data.keys().hasOnly(['name', 'brand', 'size', 'quantity', 'assigneeUid', 'status'].concat(commonKeys()))
          && request.resource.data.keys().hasAll(['name', 'status'].concat(commonKeys()))
          && commonCreateOk(request.resource.data)
          && isStrNE(request.resource.data.name, 200)
          && optStr(request.resource.data, 'brand', 200)
          && optStr(request.resource.data, 'size', 200)
          && optNumNull(request.resource.data, 'quantity', 0, 9999)
          && request.resource.data.status == 'needed'
          && (!('assigneeUid' in request.resource.data) || request.resource.data.assigneeUid == null
              || isActiveMemberUid(familyId, request.resource.data.assigneeUid));
        allow update, delete: if false;
      }

      match /handovers/{handoverId} {
        allow read: if isActiveMember(familyId);
        allow create: if isActiveMember(familyId)
          && idOk(handoverId)
          && request.resource.data.keys().hasOnly(['text', 'priority', 'recipientUids', 'expiresAt', 'relatedRefs',
               'status', 'resolvedBy', 'resolvedAt'].concat(commonKeys()))
          && request.resource.data.keys().hasAll(['text', 'priority', 'recipientUids', 'relatedRefs', 'status'].concat(commonKeys()))
          && commonCreateOk(request.resource.data)
          && isStrNE(request.resource.data.text, 2000)
          && request.resource.data.priority in ['normal', 'important']
          && uidsOk(familyId, request.resource.data.recipientUids)
          && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp)
          && refsOk(request.resource.data.relatedRefs)
          && request.resource.data.status == 'open'
          && request.resource.data.get('resolvedBy', null) == null
          && request.resource.data.get('resolvedAt', null) == null;
        allow update, delete: if false;

        // 確認(ack): 本人のみ create/update
        match /acks/{ackUid} {
          allow read: if isActiveMember(familyId);
          allow create, update: if isActiveMember(familyId)
            && ackUid == request.auth.uid
            && exists(/databases/$(database)/documents/families/$(familyId)/handovers/$(handoverId))
            && request.resource.data.handoverRevision == get(/databases/$(database)/documents/families/$(familyId)/handovers/$(handoverId)).data.revision
            && request.resource.data.keys().hasOnly(['uid', 'acknowledgedAt', 'handoverRevision'])
            && request.resource.data.keys().hasAll(['uid', 'acknowledgedAt', 'handoverRevision'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.acknowledgedAt == request.time
            && request.resource.data.handoverRevision is int
            && request.resource.data.handoverRevision >= 1;
          allow delete: if false;
        }
      }

      match /contacts/{contactId} {
        allow read: if isActiveMember(familyId);
        allow create: if isActiveMember(familyId)
          && idOk(contactId)
          && request.resource.data.keys().hasOnly(['name', 'phone', 'url', 'category', 'note'].concat(commonKeys()))
          && request.resource.data.keys().hasAll(['name', 'category'].concat(commonKeys()))
          && commonCreateOk(request.resource.data)
          && isStrNE(request.resource.data.name, 200)
          && optStr(request.resource.data, 'phone', 50)
          && optUrl(request.resource.data, 'url')
          && request.resource.data.category in ['clinic', 'municipality', 'consultation', 'other']
          && optStr(request.resource.data, 'note', 2000);
        allow update, delete: if false;
      }
    }

    // サーバーのみ（クライアントは読み書き不可）
    match /invites/{inviteId} {
      allow read, write: if false;
    }
    match /notificationJobs/{jobId} {
      allow read, write: if false;
    }

    // その他は deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
