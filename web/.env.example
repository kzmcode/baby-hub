# Firebase コンソール > プロジェクトの設定 > マイアプリ（Web）の値
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging > Web プッシュ証明書の公開鍵
VITE_FIREBASE_VAPID_KEY=
# 既定は false。ローカル開発（エミュレータ接続）のときだけ .env.local などで true にする。
# 本番ビルド（vite build）で true だとビルドが失敗する
VITE_USE_EMULATORS=false
# GAS Web アプリのエンドポイント（Cloud Functions の代替）。
# 開発: gas のローカルサーバー http://localhost:8787 / 本番: GAS Web アプリのデプロイ URL（https://script.google.com/macros/s/.../exec）
VITE_GAS_ENDPOINT=http://localhost:8787
